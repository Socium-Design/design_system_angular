{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-components": {
      "projectType": "library",
      "root": "angular-components",
      "sourceRoot": "angular-components/src",
      "prefix": "socium",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "angular-components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "angular-components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "angular-components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "angular-components/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "karmaConfig": "karma.conf.js"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "angular-components/.storybook",
            "browserTarget": "angular-components:build",
            "compodoc": false,
            "port": 6006,
            "styles": [
              "angular-components/src/styles/tailwind-entry.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "angular-components/.storybook",
            "browserTarget": "angular-components:build",
            "compodoc": false,
            "outputDir": "storybook-static",
            "styles": [
              "angular-components/src/styles/tailwind-entry.css"
            ]
          }
        }
      }
    }
  }
}
