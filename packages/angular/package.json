{
  "name": "socium-ds-angular-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Angular CLI workspace tooling — not published. The actual library is angular-components/package.json (@socium-ds/angular-components).",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "NODE_OPTIONS=--max-old-space-size=6144 ng run angular-components:storybook",
    "build-storybook": "NODE_OPTIONS=--max-old-space-size=6144 ng run angular-components:build-storybook"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
